# ============================================================================
# CIVIC SMART - POSTGRESQL ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual PostgreSQL credentials.
# Example: copy .env.example .env

# Server Port
PORT=5000

# PostgreSQL Connection Parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=civic_smartdb
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# Or use a full connection string (URI):
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/civic_smartdb
