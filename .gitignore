# ============================================================================
# CIVIC SMART - GIT IGNORE
# ============================================================================

# Environment variables & secrets (Never commit real database passwords!)
.env
*.env
backend/.env
backend/python/.env

# Python byte-code & caches
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.venv/
env/

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled C++ binaries
*.exe
*.obj
*.o

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store

# Editor directories
.vscode/
.idea/
